{
  "name": "muuhu-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:us": "pnpm --filter @muuhu/us dev",
    "dev:uk": "pnpm --filter @muuhu/uk dev",
    "build:us": "pnpm --filter @muuhu/us build",
    "build:uk": "pnpm --filter @muuhu/uk build",
    "normalize:reviews": "node scripts/normalize-reviews.mjs",
    "sync:assets": "node scripts/sync-product-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0"
}