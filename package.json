{
  "name": "muuhu-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:us": "turbo run dev --filter=@muuhu/us",
    "dev:uk": "turbo run dev --filter=@muuhu/uk",
    "build:us": "turbo run build --filter=@muuhu/us",
    "build:uk": "turbo run build --filter=@muuhu/uk",
    "normalize:reviews": "node scripts/normalize-reviews.mjs",
    "sync:assets": "node scripts/sync-product-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0"
}